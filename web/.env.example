# Accounts are optional. Leave all of these empty and PrepTime runs in guest mode (data stays in the browser).

# Backend (existing)
ML_SERVICE_URL=https://armanfathabadi-pt-backend.hf.space

# --- Accounts + sync ---------------------------------------------------------
# Postgres connection string (Neon free tier works: neon.tech > Connection string, pooled).
DATABASE_URL=
# Random secret, 32+ chars:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# The site's public URL (no trailing slash). Locally: http://localhost:3000
BETTER_AUTH_URL=

# Google:  console.cloud.google.com > APIs & Services > Credentials > OAuth client (Web)
#   redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub:  github.com/settings/developers > New OAuth App
#   callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Which buttons the login page shows (build-time). e.g. google,github
NEXT_PUBLIC_AUTH_PROVIDERS=
